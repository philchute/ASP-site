@page
@model ASP_site.Pages.Servers.IndexModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{ ViewData["Title"] = "Servers"; }

<div class="container">
    <h1 class="my-4">Game Server Browser</h1>
    <p>
        This was adapted from <a href="https://github.com/BerntA/GameServerBrowser/" target="_blank">https://github.com/BerntA/GameServerBrowser/</a>
        which was not being hosted. I also implemented the blacklist from <a href="https://github.com/Ch0wW/goldsrc-fake-servers-firewall" target="_blank">https://github.com/Ch0wW/goldsrc-fake-servers-firewall</a>
        to prevent some of the fake servers from being shown. This is still not a good browser for popular titles; I made this page to supplement the other tools that are available.
        <a href="https://www.gametracker.com/search/cs/">gametracker.com</a> is a better interface for CS 1.6 and some popular titles but I can add any arbitrary third-party mod here.
        <a href="https://cs2browser.com/">cs2browser.com</a> is a better interface for browsing CS2 servers, and includes additional filters for game modes.
        I'm adding in some former GameSpy titles now, using the <a href="https://master.333networks.com/">333Networks replacement master servers</a>.
        idtech3 titles (Quake 3, ET Legacy, RTCW, CoD 1/2/4, etc) query community master servers. Click a row to copy <code>connect ip:port</code>.
    </p>

    <form method="get" id="server-browser-form">
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-4">
                <label asp-for="GameId" class="form-label">Game:</label>
                <input type="search" id="game-search" class="form-control mb-1" placeholder="Search games..." autocomplete="off">
                @{
                    var gameCount = Model.GamesList?.Count ?? 0;
                    var selectGameText = $"-- Select a Game ({gameCount} available) --";
                    if (gameCount == 0 && Model.GameId == null) {
                        selectGameText = "-- No games available for browser --";
                    } else if (gameCount == 0 && Model.GameId != null) {
                         selectGameText = "-- Select a Game --";
                    }
                }
                <select name="GameId" id="game-select" class="form-select" asp-for="GameId" asp-items="Model.GameSelectItems" onchange="this.form.submit();">
                    <option value="">@selectGameText</option>
                </select>
            </div>

            <div class="col-md-2">
                <label asp-for="SortBy" class="form-label">Sort By:</label>
                <select asp-for="SortBy" id="sort-by" class="form-select">
                    <option value="players">Players</option>
                    <option value="name">Name</option>
                    <option value="map">Map</option>
                </select>
            </div>

            @if (Model.Columns.Vac)
            {
             <div class="col-md-2" id="vac-filter-wrap">
                <label asp-for="VacFilter" class="form-label">VAC:</label>
                <select asp-for="VacFilter" id="vac-filter" class="form-select">
                    <option value="all">All</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                </select>
            </div>
            }

            @if (Model.Columns.Password)
            {
             <div class="col-md-2" id="password-filter-wrap">
                <label asp-for="PasswordFilter" class="form-label">Password:</label>
                <select asp-for="PasswordFilter" id="password-filter" class="form-select">
                    <option value="all">All</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                </select>
            </div>
            }

            @if (Model.Columns.PunkBuster)
            {
             <div class="col-md-2" id="pb-filter-wrap">
                <label for="pb-filter" class="form-label">PunkBuster:</label>
                <select id="pb-filter" class="form-select">
                    <option value="all">All</option>
                    <option value="yes">Yes</option>
                    <option value="no">No</option>
                </select>
            </div>
            }

             <div class="col-md-2">
                <span class="form-label d-block">Population:</span>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="HideEmpty" id="hide-empty">
                    <label class="form-check-label" asp-for="HideEmpty">Hide empty</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="HideFull" id="hide-full">
                    <label class="form-check-label" asp-for="HideFull">Hide full</label>
                </div>
            </div>

            <div class="col-md-2">
                <label for="server-search" class="form-label">Search:</label>
                <input type="search" id="server-search" class="form-control" placeholder="Name, map, mode..." autocomplete="off">
            </div>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.SelectedGame != null)
    {
        <h2 class="my-4" id="server-heading">Servers for @Model.SelectedGame.Name</h2>
        <p id="server-hint" class="text-muted small d-none">Click a row to copy the console connect command. Steam games also have a Join link.</p>

        <div id="server-loading" class="d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span class="ms-2">Loading server list for @Model.SelectedGame.Name...</span>
        </div>

        <div id="server-error" class="alert alert-danger d-none" role="alert"></div>
        <p id="server-empty" class="d-none">No servers found for this game at the moment.</p>

        <div id="server-table-wrap" class="table-responsive d-none">
            <table class="table table-striped table-hover table-sm site-table">
                <thead>
                    <tr id="server-table-head"></tr>
                </thead>
                <tbody id="server-list-body"></tbody>
            </table>
        </div>
    }
    else if (Model.GameId != null)
    {
         <p>Select a game from the list above to view its servers.</p>
    }

</div>

@section Scripts {
    <script>
        const gameId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GameId));
        let allServers = [];
        let columns = {
            vac: @Html.Raw(Model.Columns.Vac ? "true" : "false"),
            password: @Html.Raw(Model.Columns.Password ? "true" : "false"),
            os: @Html.Raw(Model.Columns.Os ? "true" : "false"),
            type: @Html.Raw(Model.Columns.Type ? "true" : "false"),
            gameType: @Html.Raw(Model.Columns.GameType ? "true" : "false"),
            country: @Html.Raw(Model.Columns.Country ? "true" : "false"),
            punkBuster: @Html.Raw(Model.Columns.PunkBuster ? "true" : "false")
        };

        document.addEventListener('DOMContentLoaded', function () {
            bindGameSearch();
            ['sort-by', 'vac-filter', 'password-filter', 'pb-filter', 'hide-empty', 'hide-full'].forEach(id => {
                document.getElementById(id)?.addEventListener('change', renderServerTable);
            });
            document.getElementById('server-search')?.addEventListener('input', renderServerTable);

            if (!gameId) return;

            const params = new URLSearchParams();
            params.set('handler', 'List');
            params.set('GameId', gameId);

            fetch(`${window.location.pathname}?${params.toString()}`)
                .then(response => {
                    if (!response.ok) throw new Error('Request failed');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('server-loading')?.classList.add('d-none');
                    if (data.error) {
                        const errorEl = document.getElementById('server-error');
                        errorEl.textContent = data.error;
                        errorEl.classList.remove('d-none');
                        return;
                    }

                    allServers = data.servers || [];
                    if (data.columns) columns = data.columns;
                    const heading = document.getElementById('server-heading');
                    if (heading && data.gameName) {
                        heading.dataset.gameName = data.gameName;
                    }
                    document.getElementById('server-hint')?.classList.remove('d-none');
                    renderServerTable();
                })
                .catch(() => {
                    document.getElementById('server-loading')?.classList.add('d-none');
                    const errorEl = document.getElementById('server-error');
                    errorEl.textContent = 'Failed to load servers.';
                    errorEl.classList.remove('d-none');
                });
        });

        function bindGameSearch() {
            const input = document.getElementById('game-search');
            const select = document.getElementById('game-select');
            if (!input || !select) return;
            input.addEventListener('input', function () {
                const q = input.value.toLowerCase();
                select.querySelectorAll('option').forEach(opt => {
                    if (!opt.value) return;
                    opt.hidden = !(!q || opt.text.toLowerCase().includes(q) || opt.value.toLowerCase().includes(q));
                });
            });
        }

        function currentFilters() {
            return {
                sortBy: document.getElementById('sort-by')?.value || 'players',
                vac: document.getElementById('vac-filter')?.value || 'all',
                password: document.getElementById('password-filter')?.value || 'all',
                punkBuster: document.getElementById('pb-filter')?.value || 'all',
                hideEmpty: document.getElementById('hide-empty')?.checked === true,
                hideFull: document.getElementById('hide-full')?.checked === true,
                search: document.getElementById('server-search')?.value?.trim() || ''
            };
        }

        function applyFilters(servers) {
            const f = currentFilters();
            let list = servers.slice();
            if (f.vac === 'yes') list = list.filter(s => s.requiresVAC === true);
            else if (f.vac === 'no') list = list.filter(s => s.requiresVAC === false);
            if (f.password === 'yes') list = list.filter(s => s.passwordProtected === true);
            else if (f.password === 'no') list = list.filter(s => s.passwordProtected === false);
            if (f.punkBuster === 'yes') list = list.filter(s => s.requiresPunkBuster === true);
            else if (f.punkBuster === 'no') list = list.filter(s => s.requiresPunkBuster === false);
            if (f.hideEmpty) list = list.filter(s => s.players > 0);
            if (f.hideFull) list = list.filter(s => s.players < s.maxPlayers);
            if (f.search) {
                const q = f.search.toLowerCase();
                list = list.filter(s =>
                    (s.name || '').toLowerCase().includes(q) ||
                    (s.map || '').toLowerCase().includes(q) ||
                    (s.gameType || '').toLowerCase().includes(q) ||
                    (s.ipPort || '').toLowerCase().includes(q));
            }
            if (f.sortBy === 'name') list.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
            else if (f.sortBy === 'map') list.sort((a, b) => (a.map || '').localeCompare(b.map || '') || (b.players - a.players));
            else list.sort((a, b) => (b.players - a.players) || (a.name || '').localeCompare(b.name || ''));
            return list;
        }

        function renderServerTable() {
            const heading = document.getElementById('server-heading');
            const emptyEl = document.getElementById('server-empty');
            const wrap = document.getElementById('server-table-wrap');
            const body = document.getElementById('server-list-body');
            const head = document.getElementById('server-table-head');
            if (!body || !head) return;

            const filtered = applyFilters(allServers);
            const gameName = heading?.dataset.gameName;
            if (heading && gameName) {
                heading.textContent = `Servers for ${gameName} (${filtered.length} shown${filtered.length !== allServers.length ? ` of ${allServers.length}` : ''})`;
            }

            emptyEl?.classList.toggle('d-none', filtered.length > 0);
            wrap?.classList.toggle('d-none', filtered.length === 0);
            if (!filtered.length) {
                body.replaceChildren();
                return;
            }

            const headers = ['Name', 'Map'];
            if (columns.gameType) headers.push('Mode');
            headers.push('Players');
            if (columns.country) headers.push('Country');
            if (columns.os) headers.push('OS');
            if (columns.type) headers.push('Type');
            if (columns.vac) headers.push('VAC');
            if (columns.punkBuster) headers.push('PB');
            if (columns.password) headers.push('PW');
            headers.push('');
            head.replaceChildren();
            headers.forEach(text => {
                const th = document.createElement('th');
                th.textContent = text;
                if (text === 'OS' || text === 'Type' || text === 'VAC' || text === 'PB' || text === 'PW' || text === 'Country') {
                    th.className = 'text-center';
                }
                head.appendChild(th);
            });

            body.replaceChildren();
            filtered.forEach(server => {
                const row = document.createElement('tr');
                row.className = 'server-row';
                row.title = `${server.ipPort} (click to copy ${server.connectCommand})`;
                row.dataset.connectCommand = server.connectCommand;
                row.style.cursor = 'pointer';

                appendTextCell(row, server.name);
                appendTextCell(row, server.map);
                if (columns.gameType) appendTextCell(row, server.gameType || '');
                appendTextCell(row, server.playersStr);
                if (columns.country) {
                    const td = document.createElement('td');
                    td.className = 'text-center';
                    td.textContent = server.country || '?';
                    row.appendChild(td);
                }
                if (columns.os) appendFlagCell(row, flagLabel(server.environment, { Linux: 'L', Windows: 'W', Mac: 'M' }));
                if (columns.type) appendFlagCell(row, flagLabel(server.serverType, { Dedicated: 'D', Listen: 'L', SourceTV: 'P' }));
                if (columns.vac) appendFlagCell(row, boolLabel(server.requiresVAC));
                if (columns.punkBuster) appendFlagCell(row, boolLabel(server.requiresPunkBuster));
                if (columns.password) appendFlagCell(row, boolLabel(server.passwordProtected));

                const joinTd = document.createElement('td');
                joinTd.className = 'text-nowrap';
                if (server.steamConnectUrl) {
                    const link = document.createElement('a');
                    link.href = server.steamConnectUrl;
                    link.textContent = 'Join';
                    link.addEventListener('click', e => e.stopPropagation());
                    joinTd.appendChild(link);
                }
                row.appendChild(joinTd);
                body.appendChild(row);
            });
            bindCopyHandlers();
        }

        function appendTextCell(row, text) {
            const td = document.createElement('td');
            td.textContent = text || '';
            row.appendChild(td);
        }

        function appendFlagCell(row, text) {
            const td = document.createElement('td');
            td.className = 'text-center';
            td.textContent = text;
            row.appendChild(td);
        }

        function flagLabel(value, map) {
            return map[value] || '?';
        }

        function boolLabel(value) {
            if (value === true) return 'Y';
            if (value === false) return 'N';
            return '?';
        }

        function bindCopyHandlers() {
            document.querySelectorAll('.server-row').forEach(row => {
                row.addEventListener('click', function () {
                    const commandToCopy = this.dataset.connectCommand;
                    navigator.clipboard.writeText(commandToCopy).then(() => {
                        this.classList.add('copied-feedback');
                        setTimeout(() => { this.classList.remove('copied-feedback'); }, 500);
                    }).catch(() => {
                        alert('Failed to copy connect command.');
                    });
                });
            });
        }
    </script>
}
